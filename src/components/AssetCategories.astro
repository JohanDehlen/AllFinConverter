---
import { ASSET_CATEGORIES, getAssetsByCategory } from '../lib/assets';

/**
 * Category descriptions for the homepage cards.
 * Derived from the authoritative ASSET_CATEGORIES in assets.ts.
 */
const categoryDescriptions: Record<string, string> = {
  fiat: 'Convert major international currencies.',
  crypto: 'Convert supported cryptocurrencies.',
  metal: 'Convert gold, silver, platinum and palladium.',
};
---

<section class="asset-categories-section" aria-labelledby="categories-heading">
  <div class="categories-intro">
    <h2 id="categories-heading" class="categories-heading">Supported Asset Classes</h2>
    <p class="categories-subtitle">Planned coverage across global financial instruments</p>
  </div>

  <div class="categories-grid">
    {ASSET_CATEGORIES.map((cat) => {
      const assets = getAssetsByCategory(cat.id);
      if (assets.length === 0) return null;
      return (
        <article class="category-card">
          <div class="category-pill">{cat.pill}</div>
          <h3 class="category-title">{cat.label}</h3>
          <p class="category-description">{categoryDescriptions[cat.id] ?? ''}</p>
        </article>
      );
    })}
  </div>
</section>
