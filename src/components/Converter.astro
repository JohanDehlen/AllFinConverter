---
import {
  ASSET_CATEGORIES,
  getAssetsByCategory,
  getAsset,
  getCategoryPill,
  isPreciousMetal,
  getAssetAmountPrefix,
  getAssetAmountSuffix,
} from '../lib/assets.ts';
import {
  calculateConversion,
  formatDisplayAmount,
  formatQuantityWithUnit,
  formatUnitRateWithUnit,
  type MetalUnit,
} from '../lib/converter.ts';

interface Props {
  initialFrom?: string;
  initialTo?: string;
  initialAmount?: string;
}

const {
  initialFrom = 'USD',
  initialTo = 'EUR',
  initialAmount = '100',
} = Astro.props;

const fromMeta = getAsset(initialFrom);
const toMeta = getAsset(initialTo);
const initialBadgeFrom = fromMeta ? getCategoryPill(fromMeta.category) : 'CURRENCY';
const initialBadgeTo = toMeta ? getCategoryPill(toMeta.category) : 'CURRENCY';
const isFromMetal = isPreciousMetal(initialFrom);
const isToMetal = isPreciousMetal(initialTo);
const isInitialMetal = isFromMetal || isToMetal;

const initialFromUnit: MetalUnit = 'troy-oz';
const initialToUnit: MetalUnit = 'troy-oz';

const initialPrefixFrom = getAssetAmountPrefix(initialFrom);
const initialPrefixTo = getAssetAmountPrefix(initialTo);
const initialSuffixFrom = getAssetAmountSuffix(initialFrom, initialFromUnit);
const initialSuffixTo = getAssetAmountSuffix(initialTo, initialToUnit);

// Compute initial server-side values for instant rendering
let initialTargetAmount = '92';
let initialSummaryHeadline = `${initialAmount} ${initialFrom} = 92 ${initialTo}`;
let initialSummarySubtext = `1 ${initialFrom} = 0.92 ${initialTo} \u2022 Demo conversion using fictional development rates.`;

try {
  const initResult = calculateConversion(initialAmount, initialFrom, initialTo, {
    fromUnit: initialFromUnit,
    toUnit: initialToUnit,
  });
  initialTargetAmount = formatDisplayAmount(initResult.targetAmount);
  initialSummaryHeadline = `${formatQuantityWithUnit(initialAmount, initialFrom, initialFromUnit)} = ${formatQuantityWithUnit(initResult.targetAmount, initialTo, initialToUnit)}`;
  initialSummarySubtext = `${formatUnitRateWithUnit(initResult.unitRate, initialFrom, initialTo, initialFromUnit, initialToUnit)} \u2022 Demo conversion using fictional development rates.`;
} catch {
  // Graceful fallback if calculation fails at render time
}
---

<section class="converter-wrapper" aria-labelledby="converter-heading">
  <div class="converter-card">
    <div class="converter-card-header">
      <h2 id="converter-heading" class="converter-title">Convert Financial Assets</h2>
      <span class="demo-badge" role="status" aria-label="Demo mode: fictional mock exchange rates">
        <span class="demo-dot" aria-hidden="true"></span>
        Demo rates
      </span>
    </div>

    <div class="converter-card-body">
      <div class="converter-grid">
        <!-- Source Asset Block -->
        <div class="converter-unit">
          <div class="unit-header">
            <label for="amount-from" class="unit-label">Amount</label>
            <div class="unit-header-meta">
              <!-- Source Metal Unit Toggle -->
              <div
                id="unit-toggle-from"
                class="unit-toggle"
                style={isFromMetal ? "display: inline-flex;" : "display: none;"}
                role="radiogroup"
                aria-label="Source metal unit"
              >
                <button
                  type="button"
                  class="unit-toggle-btn active"
                  data-unit="troy-oz"
                  aria-checked="true"
                  role="radio"
                >
                  troy oz
                </button>
                <button
                  type="button"
                  class="unit-toggle-btn"
                  data-unit="g"
                  aria-checked="false"
                  role="radio"
                >
                  g
                </button>
              </div>
              <span id="badge-from" class="unit-badge">{initialBadgeFrom}</span>
            </div>
          </div>
          <div class="unit-inputs">
            <div class="amount-field-wrapper">
              <div class="amount-input-container">
                <span
                  id="prefix-from"
                  class="amount-prefix"
                  style={initialPrefixFrom ? "display: inline-flex;" : "display: none;"}
                  aria-hidden="true"
                >{initialPrefixFrom}</span>
                <input
                  id="amount-from"
                  type="text"
                  class="amount-input"
                  value={initialAmount}
                  placeholder="0"
                  size={initialAmount ? initialAmount.length : 1}
                  inputmode="decimal"
                  autocomplete="off"
                  spellcheck="false"
                  aria-label="Source amount"
                  aria-describedby="summary-headline"
                />
                <span
                  id="suffix-from"
                  class="amount-suffix"
                  style={initialSuffixFrom ? "display: inline-flex;" : "display: none;"}
                  aria-hidden="true"
                >{initialSuffixFrom}</span>
              </div>
            </div>
            <div class="asset-field-wrapper">
              <select id="asset-from" class="asset-select" aria-label="Source asset">
                {ASSET_CATEGORIES.map((cat) => {
                  const categoryAssets = getAssetsByCategory(cat.id);
                  return (
                    <optgroup label={cat.label}>
                      {categoryAssets.map((asset) => (
                        <option value={asset.code} selected={asset.code === initialFrom}>
                          {asset.code} &mdash; {asset.name}
                        </option>
                      ))}
                    </optgroup>
                  );
                })}
              </select>
            </div>
          </div>
        </div>

        <!-- Swap Control -->
        <div class="swap-divider">
          <button
            id="swap-button"
            type="button"
            class="swap-btn"
            aria-label="Swap source and destination assets"
            title="Swap assets"
          >
            <svg class="swap-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="9" x2="17" y2="9"></line>
              <polyline points="13 5 17 9 13 13"></polyline>
              <line x1="17" y1="15" x2="7" y2="15"></line>
              <polyline points="11 19 7 15 11 11"></polyline>
            </svg>
          </button>
        </div>

        <!-- Destination Asset Block -->
        <div class="converter-unit">
          <div class="unit-header">
            <label for="amount-to" class="unit-label">Converted to (estimate)</label>
            <div class="unit-header-meta">
              <!-- Destination Metal Unit Toggle -->
              <div
                id="unit-toggle-to"
                class="unit-toggle"
                style={isToMetal ? "display: inline-flex;" : "display: none;"}
                role="radiogroup"
                aria-label="Destination metal unit"
              >
                <button
                  type="button"
                  class="unit-toggle-btn active"
                  data-unit="troy-oz"
                  aria-checked="true"
                  role="radio"
                >
                  troy oz
                </button>
                <button
                  type="button"
                  class="unit-toggle-btn"
                  data-unit="g"
                  aria-checked="false"
                  role="radio"
                >
                  g
                </button>
              </div>
              <span id="badge-to" class="unit-badge">{initialBadgeTo}</span>
            </div>
          </div>
          <div class="unit-inputs">
            <div class="amount-field-wrapper">
              <div class="amount-input-container">
                <span
                  id="prefix-to"
                  class="amount-prefix"
                  style={initialPrefixTo ? "display: inline-flex;" : "display: none;"}
                  aria-hidden="true"
                >{initialPrefixTo}</span>
                <input
                  id="amount-to"
                  type="text"
                  class="amount-input"
                  value={initialTargetAmount}
                  placeholder="0"
                  size={initialTargetAmount ? initialTargetAmount.length : 1}
                  inputmode="decimal"
                  autocomplete="off"
                  spellcheck="false"
                  aria-label="Converted amount"
                  aria-describedby="summary-headline"
                />
                <span
                  id="suffix-to"
                  class="amount-suffix"
                  style={initialSuffixTo ? "display: inline-flex;" : "display: none;"}
                  aria-hidden="true"
                >{initialSuffixTo}</span>
              </div>
            </div>
            <div class="asset-field-wrapper">
              <select id="asset-to" class="asset-select" aria-label="Destination asset">
                {ASSET_CATEGORIES.map((cat) => {
                  const categoryAssets = getAssetsByCategory(cat.id);
                  return (
                    <optgroup label={cat.label}>
                      {categoryAssets.map((asset) => (
                        <option value={asset.code} selected={asset.code === initialTo}>
                          {asset.code} &mdash; {asset.name}
                        </option>
                      ))}
                    </optgroup>
                  );
                })}
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- Converted Result Display -->
      <div class="conversion-summary" aria-live="polite">
        <div class="summary-rate">
          <span id="summary-headline" class="summary-calculation">{initialSummaryHeadline}</span>
        </div>
        <p id="summary-subtext" class="summary-disclaimer">
          {initialSummarySubtext}
        </p>
        <p id="metal-note" class="metal-disclaimer" style={isInitialMetal ? "display: block;" : "display: none;"}>
          Precious metals are represented as reference assets in this development version.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import Big from 'big.js';
  import {
    calculateConversion,
    convertTroyOzToGrams,
    convertGramsToTroyOz,
    formatDisplayAmount,
    formatQuantityWithUnit,
    formatUnitRateWithUnit,
    sanitizeAmountInput,
    type MetalUnit,
  } from '../lib/converter.ts';
  import {
    getAsset,
    getCategoryPill,
    isPreciousMetal,
    getAssetAmountPrefix,
    getAssetAmountSuffix,
  } from '../lib/assets.ts';

  function initConverter() {
    const amountFrom = document.getElementById('amount-from') as HTMLInputElement | null;
    const amountTo = document.getElementById('amount-to') as HTMLInputElement | null;
    const assetFrom = document.getElementById('asset-from') as HTMLSelectElement | null;
    const assetTo = document.getElementById('asset-to') as HTMLSelectElement | null;
    const swapBtn = document.getElementById('swap-button') as HTMLButtonElement | null;
    const badgeFrom = document.getElementById('badge-from') as HTMLElement | null;
    const badgeTo = document.getElementById('badge-to') as HTMLElement | null;
    const unitToggleFrom = document.getElementById('unit-toggle-from') as HTMLElement | null;
    const unitToggleTo = document.getElementById('unit-toggle-to') as HTMLElement | null;
    const prefixFrom = document.getElementById('prefix-from') as HTMLElement | null;
    const prefixTo = document.getElementById('prefix-to') as HTMLElement | null;
    const suffixFrom = document.getElementById('suffix-from') as HTMLElement | null;
    const suffixTo = document.getElementById('suffix-to') as HTMLElement | null;
    const summaryHeadline = document.getElementById('summary-headline') as HTMLElement | null;
    const summarySubtext = document.getElementById('summary-subtext') as HTMLElement | null;
    const metalNote = document.getElementById('metal-note') as HTMLElement | null;

    if (
      !amountFrom ||
      !amountTo ||
      !assetFrom ||
      !assetTo ||
      !swapBtn ||
      !summaryHeadline ||
      !summarySubtext ||
      !unitToggleFrom ||
      !unitToggleTo
    ) {
      return;
    }

    let activeSide: 'from' | 'to' = 'from';
    let isCalculating = false;
    let fromUnit: MetalUnit = 'troy-oz';
    let toUnit: MetalUnit = 'troy-oz';

    function updateCategoryBadges() {
      const metaFrom = getAsset(assetFrom!.value);
      const metaTo = getAsset(assetTo!.value);
      if (metaFrom && badgeFrom) {
        badgeFrom.textContent = getCategoryPill(metaFrom.category);
      }
      if (metaTo && badgeTo) {
        badgeTo.textContent = getCategoryPill(metaTo.category);
      }

      const isMetalInvolved = metaFrom?.category === 'metal' || metaTo?.category === 'metal';
      if (metalNote) {
        metalNote.style.display = isMetalInvolved ? 'block' : 'none';
      }
    }

    function updateAmountAffixes() {
      const pFrom = getAssetAmountPrefix(assetFrom!.value);
      const pTo = getAssetAmountPrefix(assetTo!.value);
      const sFrom = getAssetAmountSuffix(assetFrom!.value, fromUnit);
      const sTo = getAssetAmountSuffix(assetTo!.value, toUnit);

      if (prefixFrom) {
        prefixFrom.textContent = pFrom;
        prefixFrom.style.display = pFrom ? 'inline-flex' : 'none';
      }
      if (prefixTo) {
        prefixTo.textContent = pTo;
        prefixTo.style.display = pTo ? 'inline-flex' : 'none';
      }
      if (suffixFrom) {
        suffixFrom.textContent = sFrom;
        suffixFrom.style.display = sFrom ? 'inline-flex' : 'none';
      }
      if (suffixTo) {
        suffixTo.textContent = sTo;
        suffixTo.style.display = sTo ? 'inline-flex' : 'none';
      }
    }

    function updateUnitToggleUI() {
      const fromIsMetal = isPreciousMetal(assetFrom!.value);
      const toIsMetal = isPreciousMetal(assetTo!.value);

      unitToggleFrom!.style.display = fromIsMetal ? 'inline-flex' : 'none';
      unitToggleTo!.style.display = toIsMetal ? 'inline-flex' : 'none';

      if (!fromIsMetal) fromUnit = 'troy-oz';
      if (!toIsMetal) toUnit = 'troy-oz';

      const fromBtns = unitToggleFrom!.querySelectorAll<HTMLButtonElement>('.unit-toggle-btn');
      fromBtns.forEach((btn) => {
        const u = btn.getAttribute('data-unit');
        const isActive = u === fromUnit;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-checked', isActive ? 'true' : 'false');
      });

      const toBtns = unitToggleTo!.querySelectorAll<HTMLButtonElement>('.unit-toggle-btn');
      toBtns.forEach((btn) => {
        const u = btn.getAttribute('data-unit');
        const isActive = u === toUnit;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-checked', isActive ? 'true' : 'false');
      });
    }

    function recalculate() {
      if (isCalculating) return;
      isCalculating = true;

      try {
        const fromCode = assetFrom!.value;
        const toCode = assetTo!.value;
        updateCategoryBadges();
        updateUnitToggleUI();
        updateAmountAffixes();

        const activeInput = activeSide === 'from' ? amountFrom! : amountTo!;
        const targetInput = activeSide === 'from' ? amountTo! : amountFrom!;

        // Clear previous error indicators
        amountFrom!.removeAttribute('aria-invalid');
        amountTo!.removeAttribute('aria-invalid');

        const rawSanitized = sanitizeAmountInput(activeInput.value);
        if (activeInput.value !== rawSanitized) {
          activeInput.value = rawSanitized;
        }

        const unformatted = rawSanitized.replace(/,/g, '').trim();

        // Reject negative numbers safely with clear non-technical feedback
        if (unformatted.startsWith('-')) {
          targetInput.value = '';
          activeInput.setAttribute('aria-invalid', 'true');
          summaryHeadline!.textContent = 'Amount must be positive';
          summarySubtext!.textContent = 'Negative financial amounts are not supported.';
          return;
        }

        // Handle empty or standalone decimal point input
        if (!unformatted || unformatted === '.') {
          targetInput.value = '';
          try {
            const baseResult = calculateConversion('1', fromCode, toCode, { fromUnit, toUnit });
            summaryHeadline!.textContent = formatUnitRateWithUnit(baseResult.unitRate, fromCode, toCode, fromUnit, toUnit);
            summarySubtext!.textContent = 'Demo conversion using fictional development rates.';
          } catch (baseErr: unknown) {
            const msg = baseErr instanceof Error ? baseErr.message : 'Rate data is unavailable.';
            summaryHeadline!.textContent = 'Rate unavailable';
            summarySubtext!.textContent = msg;
          }
          return;
        }

        // Handle typing of trailing dot gracefully (e.g. "100.")
        const calcInput = unformatted.endsWith('.') ? unformatted.slice(0, -1) : unformatted;

        let bigAmount: Big;
        try {
          bigAmount = new Big(calcInput);
        } catch {
          return;
        }

        try {
          if (activeSide === 'from') {
            const result = calculateConversion(bigAmount, fromCode, toCode, { fromUnit, toUnit });
            targetInput.value = formatDisplayAmount(result.targetAmount);
            summaryHeadline!.textContent = `${formatQuantityWithUnit(bigAmount, fromCode, fromUnit)} = ${formatQuantityWithUnit(result.targetAmount, toCode, toUnit)}`;
            summarySubtext!.textContent = `${formatUnitRateWithUnit(result.unitRate, fromCode, toCode, fromUnit, toUnit)} \u2022 Demo conversion using fictional development rates.`;
          } else {
            const result = calculateConversion(bigAmount, toCode, fromCode, { fromUnit: toUnit, toUnit: fromUnit });
            targetInput.value = formatDisplayAmount(result.targetAmount);
            summaryHeadline!.textContent = `${formatQuantityWithUnit(result.targetAmount, fromCode, fromUnit)} = ${formatQuantityWithUnit(bigAmount, toCode, toUnit)}`;
            summarySubtext!.textContent = `${formatUnitRateWithUnit(result.inverseRate, fromCode, toCode, fromUnit, toUnit)} \u2022 Demo conversion using fictional development rates.`;
          }
        } catch (calcErr: unknown) {
          targetInput.value = '';
          const msg = calcErr instanceof Error ? calcErr.message : 'Rate data is unavailable.';
          summaryHeadline!.textContent = 'Conversion unavailable';
          summarySubtext!.textContent = msg;
        } finally {
          syncInputSizes();
        }
      } finally {
        isCalculating = false;
      }
    }

    function syncInputSizes() {
      if (amountFrom) {
        amountFrom.size = Math.max(1, (amountFrom.value || '0').length);
      }
      if (amountTo) {
        amountTo.size = Math.max(1, (amountTo.value || '0').length);
      }
    }

    // Amount field container click to focus input
    const wrapperFrom = amountFrom.closest('.amount-field-wrapper');
    const wrapperTo = amountTo.closest('.amount-field-wrapper');

    wrapperFrom?.addEventListener('click', (e) => {
      if (e.target !== amountFrom) amountFrom.focus();
    });

    wrapperTo?.addEventListener('click', (e) => {
      if (e.target !== amountTo) amountTo.focus();
    });

    // Input event listeners for two-way reactivity
    amountFrom.addEventListener('input', () => {
      activeSide = 'from';
      recalculate();
    });

    amountTo.addEventListener('input', () => {
      activeSide = 'to';
      recalculate();
    });

    // Formatting on blur
    amountFrom.addEventListener('blur', () => {
      const val = amountFrom.value.replace(/,/g, '').trim();
      if (val.startsWith('-')) return;
      if (val && val !== '.') {
        try {
          amountFrom.value = formatDisplayAmount(new Big(val));
          syncInputSizes();
        } catch {}
      }
    });

    amountTo.addEventListener('blur', () => {
      const val = amountTo.value.replace(/,/g, '').trim();
      if (val.startsWith('-')) return;
      if (val && val !== '.') {
        try {
          amountTo.value = formatDisplayAmount(new Big(val));
          syncInputSizes();
        } catch {}
      }
    });

    // Select change listeners
    assetFrom.addEventListener('change', () => {
      fromUnit = 'troy-oz';
      recalculate();
    });

    assetTo.addEventListener('change', () => {
      toUnit = 'troy-oz';
      recalculate();
    });

    // Unit toggle button click listeners (Source Side)
    unitToggleFrom.querySelectorAll<HTMLButtonElement>('.unit-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const newUnit = btn.getAttribute('data-unit') as MetalUnit;
        if (!newUnit || newUnit === fromUnit) return;

        // Convert current source amount so financial value is preserved
        const rawVal = amountFrom.value.replace(/,/g, '').trim();
        if (rawVal && rawVal !== '.' && !rawVal.startsWith('-')) {
          try {
            const currentBig = new Big(rawVal);
            const converted = fromUnit === 'troy-oz' && newUnit === 'g'
              ? convertTroyOzToGrams(currentBig)
              : convertGramsToTroyOz(currentBig);
            amountFrom.value = formatDisplayAmount(converted);
          } catch {}
        }

        fromUnit = newUnit;
        activeSide = 'from';
        recalculate();
      });
    });

    // Unit toggle button click listeners (Destination Side)
    unitToggleTo.querySelectorAll<HTMLButtonElement>('.unit-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const newUnit = btn.getAttribute('data-unit') as MetalUnit;
        if (!newUnit || newUnit === toUnit) return;

        toUnit = newUnit;
        recalculate();
      });
    });

    // Swap button listener with subtle rotational animation feedback
    swapBtn.addEventListener('click', () => {
      swapBtn.classList.add('swapping');
      setTimeout(() => swapBtn.classList.remove('swapping'), 300);

      const prevFromCode = assetFrom.value;
      const prevToCode = assetTo.value;
      assetFrom.value = prevToCode;
      assetTo.value = prevFromCode;

      const prevFromVal = amountFrom.value;
      const prevToVal = amountTo.value;
      amountFrom.value = prevToVal;
      amountTo.value = prevFromVal;

      const prevFromUnit = fromUnit;
      fromUnit = toUnit;
      toUnit = prevFromUnit;

      activeSide = 'from';
      recalculate();
    });

    // Initial calculation run
    updateCategoryBadges();
    updateUnitToggleUI();
    updateAmountAffixes();
    recalculate();
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initConverter);
  } else {
    initConverter();
  }
</script>
