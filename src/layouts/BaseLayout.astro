---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { resolveCanonicalUrl, type PageMetadata } from '../lib/seo';
import '../styles/global.css';

interface Props extends Partial<PageMetadata> {
  siteTitleSuffix?: boolean;
  ogImageAlt?: string;
}

const {
  title = 'AllFinConverter — Currency, Crypto & Precious Metals Converter',
  description = 'Instantly convert between currencies, cryptocurrencies, and precious metals with AllFinConverter. Check indicative rates in one simple converter.',
  canonicalUrl,
  ogImage = '/social-preview.png',
  ogImageAlt = 'AllFinConverter — Currency, Crypto and Precious Metals Converter',
  ogType = 'website',
  robots = 'index, follow',
  structuredData,
  siteTitleSuffix = true,
} = Astro.props;

const pageTitle = siteTitleSuffix && !title.includes('AllFinConverter')
  ? `${title} | AllFinConverter`
  : title;

const resolvedCanonical = canonicalUrl ?? resolveCanonicalUrl(Astro.url.pathname, Astro.site);
const resolvedOgImage = ogImage
  ? new URL(ogImage, Astro.site ?? 'https://allfinconverter.com').href
  : undefined;
const defaultOgImageUrl = new URL('/social-preview.png', Astro.site ?? 'https://allfinconverter.com').href;

const jsonLdData = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Technical SEO Metadata -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph Metadata -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="AllFinConverter" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {resolvedOgImage && <meta property="og:image:alt" content={ogImageAlt} />}
    {resolvedOgImage === defaultOgImageUrl && <meta property="og:image:width" content="1200" />}
    {resolvedOgImage === defaultOgImageUrl && <meta property="og:image:height" content="630" />}

    <!-- Twitter Cards Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    {resolvedOgImage && <meta name="twitter:image:alt" content={ogImageAlt} />}

    <!-- Structured Data (JSON-LD) -->
    {jsonLdData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Additional Page-Specific Head Elements Slot -->
    <slot name="head" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
