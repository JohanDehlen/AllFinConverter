---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout
  title="WorthPair"
  description="Currency, Crypto & Precious Metals Converter"
>
  <main class="container">
    <header class="hero">
      <h1 class="site-title">WorthPair</h1>
      <p class="site-description">Currency, Crypto & Precious Metals Converter</p>
    </header>

    <section class="status-card" aria-label="Development Status">
      <p class="status-badge">Foundation build in progress.</p>
    </section>
  </main>
</BaseLayout>
