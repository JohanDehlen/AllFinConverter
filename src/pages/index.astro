---
import BaseLayout from '../layouts/BaseLayout.astro';
import Converter from '../components/Converter.astro';
import AssetCategories from '../components/AssetCategories.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
import { getWebSiteStructuredData, getWebApplicationStructuredData } from '../lib/seo';

const pageTitle = 'AllFinConverter — Currency, Crypto & Precious Metals Converter';
const pageDescription =
  'Fast, high-precision currency, cryptocurrency, and precious metals converter. Convert between fiat, crypto, and commodity reference assets instantly.';

const structuredData = [
  getWebSiteStructuredData(),
  getWebApplicationStructuredData(),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <main class="page-main">
    <div class="page-layout-shell">
      <!-- Desktop Side Rail: Left -->
      <AdPlaceholder
        slotId="home-desktop-left"
        variant="side-rail"
        class="ad-rail-left"
      />

      <!-- Centered Main Content -->
      <div class="content-container">
        <section class="hero-section" aria-label="Introduction">
          <h1 class="hero-title">Currency, Crypto & Precious Metals Converter</h1>
          <p class="hero-tagline">
            The fastest way to convert anything financial into anything else.
          </p>
        </section>

        <Converter />

        <!-- Converter Legal & Indicative Rates Disclaimer -->
        <p class="converter-disclaimer">
          AllFinConverter provides indicative conversion information for general reference only. Rates may be delayed or inaccurate and may differ from actual transaction prices. This is not financial advice. Verify rates independently before making financial decisions. See our <a href="/terms">Terms of Use &amp; Disclaimer</a>.
        </p>

        <!-- Responsive Ad Placement: Sub-Converter -->
        <AdPlaceholder
          slotId="home-sub-converter"
          variant="banner"
          class="ad-banner-converter"
        />

        <AssetCategories />

        <!-- Responsive Ad Placement: Pre-Footer -->
        <AdPlaceholder
          slotId="home-pre-footer"
          variant="banner"
          class="ad-banner-footer"
        />
      </div>

      <!-- Desktop Side Rail: Right -->
      <AdPlaceholder
        slotId="home-desktop-right"
        variant="side-rail"
        class="ad-rail-right"
      />
    </div>
  </main>
</BaseLayout>
