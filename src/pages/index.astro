---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConverterPlaceholder from '../components/ConverterPlaceholder.astro';
import AssetCategories from '../components/AssetCategories.astro';
---

<BaseLayout
  title="WorthPair — Currency, Crypto & Precious Metals Converter"
  description="Currency, Crypto & Precious Metals Converter. The fastest way to convert anything financial into anything else."
>
  <main class="page-main">
    <div class="content-container">
      <section class="hero-section" aria-label="Introduction">
        <h1 class="hero-title">Currency, Crypto & Precious Metals Converter</h1>
        <p class="hero-tagline">
          The fastest way to convert anything financial into anything else.
        </p>
      </section>

      <ConverterPlaceholder />

      <AssetCategories />
    </div>
  </main>
</BaseLayout>
