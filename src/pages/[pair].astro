---
import BaseLayout from '../layouts/BaseLayout.astro';
import Converter from '../components/Converter.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
import { getFeaturedPairs, getRelatedPairs, isGoldOrSilverPair, type ConversionPair } from '../lib/pairs';
import { GRAMS_PER_TROY_OUNCE_STR } from '../lib/assets.ts';
import {
  getWebSiteStructuredData,
  getWebApplicationStructuredData,
  getBreadcrumbStructuredData,
  resolveCanonicalUrl,
} from '../lib/seo';

export async function getStaticPaths() {
  const pairs = getFeaturedPairs();
  return pairs.map((pair) => ({
    params: { pair: pair.slug },
    props: { pair },
  }));
}

interface Props {
  pair: ConversionPair;
}

const { pair } = Astro.props;

const relatedPairs = getRelatedPairs(pair.slug, 4);

// Friendly category labels
function getCategoryDisplay(cat: string): string {
  if (cat === 'fiat') return 'Currency';
  if (cat === 'crypto') return 'Cryptocurrency';
  if (cat === 'metal') return 'Precious Metal (Reference Asset)';
  return cat;
}

const fromCategoryDisplay = getCategoryDisplay(pair.fromAsset.category);
const toCategoryDisplay = getCategoryDisplay(pair.toAsset.category);

const canonicalUrl = resolveCanonicalUrl(`/${pair.slug}`, Astro.site);
const siteBase = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://allfinconverter.com';

const structuredData = [
  getWebSiteStructuredData(siteBase),
  getWebApplicationStructuredData(siteBase),
  getBreadcrumbStructuredData([
    { name: 'Home', url: `${siteBase}/` },
    { name: `${pair.fromAsset.code} to ${pair.toAsset.code}`, url: canonicalUrl },
  ]),
];
---

<BaseLayout
  title={pair.title}
  description={pair.description}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
>
  <main class="page-main">
    <div class="page-layout-shell">
      <!-- Desktop Side Rail: Left -->
      <AdPlaceholder
        slotId="pair-desktop-left"
        variant="side-rail"
        class="ad-rail-left"
      />

      <div class="content-container">
        <!-- Breadcrumb Navigation -->
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <ol class="breadcrumb-list">
            <li class="breadcrumb-item">
              <a href="/" class="breadcrumb-link">Home</a>
            </li>
            <li class="breadcrumb-separator" aria-hidden="true">/</li>
            <li class="breadcrumb-item breadcrumb-current" aria-current="page">
              {pair.fromAsset.code} to {pair.toAsset.code}
            </li>
          </ol>
        </nav>

        <!-- Pair Hero Header -->
        <section class="pair-hero-section" aria-label="Conversion pair header">
          <h1 class="hero-title">{pair.headline}</h1>
          <p class="hero-tagline">
            Convert {pair.fromAsset.name} ({pair.fromAsset.code}) to {pair.toAsset.name} ({pair.toAsset.code}) with AllFinConverter's high-precision converter.
          </p>
        </section>

        <!-- Pre-configured Interactive Converter Component -->
        <Converter initialFrom={pair.fromCode} initialTo={pair.toCode} isPairPage={true} />

        <!-- Converter Legal & Indicative Rates Disclaimer -->
        <p class="converter-disclaimer">
          AllFinConverter provides indicative conversion information for general reference only. Rates may be delayed or inaccurate and may differ from actual transaction prices. This is not financial advice. Verify rates independently before making financial decisions. See our <a href="/terms">Terms of Use &amp; Disclaimer</a>.
        </p>

        <!-- Responsive Ad Placement: Sub-Converter -->
        <AdPlaceholder
          slotId="pair-sub-converter"
          variant="banner"
          class="ad-banner-converter"
        />

        <!-- Pair Overview & Rate Summary -->
      <section class="pair-details-section" aria-label="Pair conversion details">
        <div class="pair-details-card">
          <div class="pair-details-header">
            <h2 class="pair-details-title">{pair.fromAsset.code} / {pair.toAsset.code} Conversion Overview</h2>
          </div>

          <p>
            This overview does not display static example rates. Use the interactive converter above to calculate conversions. It displays live reference rates when available and validated; otherwise, it clearly indicates demo mode.
          </p>

          <div class="pair-assets-info">
            <div class="asset-info-col">
              <h3 class="asset-info-name">{pair.fromAsset.name}</h3>
              <dl class="asset-meta-list">
                <div class="asset-meta-row">
                  <dt>Code</dt>
                  <dd>{pair.fromCode}</dd>
                </div>
                <div class="asset-meta-row">
                  <dt>Category</dt>
                  <dd>{fromCategoryDisplay}</dd>
                </div>
                {pair.fromAsset.symbol && (
                  <div class="asset-meta-row">
                    <dt>Symbol</dt>
                    <dd>{pair.fromAsset.symbol}</dd>
                  </div>
                )}
                {pair.fromAsset.defaultUnit && (
                  <div class="asset-meta-row">
                    <dt>Unit</dt>
                    <dd>{pair.fromAsset.category === 'metal' ? 'troy oz (default), g' : pair.fromAsset.defaultUnit}</dd>
                  </div>
                )}
              </dl>
            </div>

            <div class="asset-info-col">
              <h3 class="asset-info-name">{pair.toAsset.name}</h3>
              <dl class="asset-meta-list">
                <div class="asset-meta-row">
                  <dt>Code</dt>
                  <dd>{pair.toCode}</dd>
                </div>
                <div class="asset-meta-row">
                  <dt>Category</dt>
                  <dd>{toCategoryDisplay}</dd>
                </div>
                {pair.toAsset.symbol && (
                  <div class="asset-meta-row">
                    <dt>Symbol</dt>
                    <dd>{pair.toAsset.symbol}</dd>
                  </div>
                )}
                {pair.toAsset.defaultUnit && (
                  <div class="asset-meta-row">
                    <dt>Unit</dt>
                    <dd>{pair.toAsset.category === 'metal' ? 'troy oz (default), g' : pair.toAsset.defaultUnit}</dd>
                  </div>
                )}
              </dl>
            </div>
          </div>

          {isGoldOrSilverPair(pair) && (
            <p>
              Precious metals are priced by default in troy ounces. You can switch to grams using the unit selector. One troy ounce equals {GRAMS_PER_TROY_OUNCE_STR} grams. Changing the unit preserves the equivalent quantity and updates the conversion accordingly.
            </p>
          )}

        </div>
      </section>

      <!-- Related Generated Pairs -->
      {relatedPairs.length > 0 && (
        <section class="related-pairs-section" aria-label="Related conversion pairs">
          <div class="related-pairs-header">
            <h2 class="related-pairs-heading">Related Conversion Pairs</h2>
            <p class="related-pairs-subheading">Related conversions</p>
          </div>
          <div class="related-pairs-grid">
            {relatedPairs.map((rel) => (
              <a href={`/${rel.slug}`} class="related-pair-card">
                <div class="related-pair-codes">
                  <span class="related-code">{rel.fromCode}</span>
                  <span class="related-arrow" aria-hidden="true">&rarr;</span>
                  <span class="related-code">{rel.toCode}</span>
                </div>
                <div class="related-pair-names">
                  {rel.fromAsset.name} to {rel.toAsset.name}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Crawlable Back Link -->
      <div class="back-home-container">
        <a href="/" class="back-home-link">
          <span aria-hidden="true">&larr;</span> All Currencies & Assets
        </a>
      </div>

      <!-- Responsive Ad Placement: Pre-Footer -->
      <AdPlaceholder
        slotId="pair-pre-footer"
        variant="banner"
        class="ad-banner-footer"
      />
    </div>

    <!-- Desktop Side Rail: Right -->
    <AdPlaceholder
      slotId="pair-desktop-right"
      variant="side-rail"
      class="ad-rail-right"
    />
  </div>
</main>
</BaseLayout>
