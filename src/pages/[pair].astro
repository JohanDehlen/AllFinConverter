---
import BaseLayout from '../layouts/BaseLayout.astro';
import Converter from '../components/Converter.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';
import { getAssetNameWithCode, getFeaturedPairs, getRelatedPairs, type ConversionPair } from '../lib/pairs';
import { GRAMS_PER_TROY_OUNCE_STR } from '../lib/assets.ts';
import {
  getWebSiteStructuredData,
  getWebApplicationStructuredData,
  getBreadcrumbStructuredData,
  resolveCanonicalUrl,
} from '../lib/seo';

export async function getStaticPaths() {
  const pairs = getFeaturedPairs();
  return pairs.map((pair) => ({
    params: { pair: pair.slug },
    props: { pair },
  }));
}

interface Props {
  pair: ConversionPair;
}

const { pair } = Astro.props;

const relatedPairs = getRelatedPairs(pair.slug, 4);
const isFiatPair = pair.fromAsset.category === 'fiat' && pair.toAsset.category === 'fiat';
const isCryptoPair = pair.fromAsset.category === 'crypto' || pair.toAsset.category === 'crypto';
const isCryptoToFiatPair = pair.fromAsset.category === 'crypto' && pair.toAsset.category === 'fiat';
const isFiatToCryptoPair = pair.fromAsset.category === 'fiat' && pair.toAsset.category === 'crypto';
const isMetalPair = pair.fromAsset.category === 'metal' || pair.toAsset.category === 'metal';
const isUsdToEurPair = pair.fromCode === 'USD' && pair.toCode === 'EUR';
const isUsdToAedPair = pair.fromCode === 'USD' && pair.toCode === 'AED';
const isBtcToUsdPair = pair.fromCode === 'BTC' && pair.toCode === 'USD';
const isUsdToBtcPair = pair.fromCode === 'USD' && pair.toCode === 'BTC';
const isGoldToUsdPair = pair.fromCode === 'XAU' && pair.toCode === 'USD';
const isUsdToGoldPair = pair.fromCode === 'USD' && pair.toCode === 'XAU';
const isNzdToZarPair = pair.fromCode === 'NZD' && pair.toCode === 'ZAR';

// Friendly category labels
function getCategoryDisplay(cat: string): string {
  if (cat === 'fiat') return 'Currency';
  if (cat === 'crypto') return 'Cryptocurrency';
  if (cat === 'metal') return 'Precious Metal (Reference Asset)';
  return cat;
}

const fromCategoryDisplay = getCategoryDisplay(pair.fromAsset.category);
const toCategoryDisplay = getCategoryDisplay(pair.toAsset.category);

const canonicalUrl = resolveCanonicalUrl(`/${pair.slug}/`, Astro.site);
const siteBase = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://allfinconverter.com';

const structuredData = [
  getWebSiteStructuredData(siteBase),
  getWebApplicationStructuredData(siteBase),
  getBreadcrumbStructuredData([
    { name: 'Home', url: `${siteBase}/` },
    { name: `${pair.fromAsset.code} to ${pair.toAsset.code}`, url: canonicalUrl },
  ]),
];
---

<BaseLayout
  title={pair.title}
  description={pair.description}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
>
  <main class="page-main">
    <div class="page-layout-shell">
      <!-- Desktop Side Rail: Left -->
      <AdPlaceholder
        slotId="pair-desktop-left"
        variant="side-rail"
        class="ad-rail-left"
      />

      <div class="content-container">
        <!-- Breadcrumb Navigation -->
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <ol class="breadcrumb-list">
            <li class="breadcrumb-item">
              <a href="/" class="breadcrumb-link">Home</a>
            </li>
            <li class="breadcrumb-separator" aria-hidden="true">/</li>
            <li class="breadcrumb-item breadcrumb-current" aria-current="page">
              {pair.fromAsset.code} to {pair.toAsset.code}
            </li>
          </ol>
        </nav>

        <!-- Pair Hero Header -->
        <section class="pair-hero-section" aria-label="Conversion pair header">
          <h1 class="hero-title">{pair.headline}</h1>
          <p class="hero-tagline">
            Convert {getAssetNameWithCode(pair.fromAsset)} to {getAssetNameWithCode(pair.toAsset)} with AllFinConverter's high-precision converter.
          </p>
        </section>

        <!-- Pre-configured Interactive Converter Component -->
        <Converter initialFrom={pair.fromCode} initialTo={pair.toCode} isPairPage={true} />

        <!-- Converter Legal & Indicative Rates Disclaimer -->
        <p class="converter-disclaimer">
          AllFinConverter provides indicative conversion information for general reference only. Rates may be delayed or inaccurate and may differ from actual transaction prices. This is not financial advice. Verify rates independently before making financial decisions. See our <a href="/terms/">Terms of Use &amp; Disclaimer</a>.
        </p>

        <!-- Responsive Ad Placement: Sub-Converter -->
        <AdPlaceholder
          slotId="pair-sub-converter"
          variant="banner"
          class="ad-banner-converter"
        />

        <!-- Pair Overview & Rate Summary -->
      <section class="pair-details-section" aria-label="Pair conversion details">
        <div class="pair-details-card">
          <div class="pair-details-header">
            <h2 class="pair-details-title">{pair.fromAsset.code} / {pair.toAsset.code} Conversion Overview</h2>
          </div>

          {isFiatPair && (
            <p>
              This page converts an amount in {pair.fromCode} to an indicative amount in {pair.toCode}. The reverse direction starts with {pair.toCode} and estimates {pair.fromCode} instead. These reference rates may differ from rates offered by banks, card providers, or exchange services; sources and publication schedules vary by currency.
              {pair.fromCode !== 'USD' && pair.toCode !== 'USD' && (
                <span> Because neither currency is USD, the cross-rate is derived from their USD-based reference rates.</span>
              )}
            </p>
          )}

          {isCryptoPair && (
            <p>
              Cryptocurrency markets trade continuously, so reference prices can change at any time. This is an indicative conversion based on available reference data, not a guaranteed exchange execution or purchase price.
            </p>
          )}

          {isCryptoToFiatPair && (
            <p>
              In this direction, the entered {pair.fromCode} amount is converted to an indicative {pair.toCode} value. It is not a guaranteed sale price or the net amount you would receive after any provider fees.
            </p>
          )}

          {isFiatToCryptoPair && (
            <p>
              In this direction, the entered {pair.fromCode} amount is converted to an indicative {pair.toCode} equivalent. It is not a guaranteed purchase quantity or an exchange quote after any provider fees.
            </p>
          )}

          {isMetalPair && (
            <p>
              Precious-metal reference prices are expressed in USD per troy ounce. One troy ounce equals {GRAMS_PER_TROY_OUNCE_STR} grams; use the unit selector to view a metal quantity in grams. This is not a retail buying or selling price for a physical coin, bar, or piece of jewellery. Premiums, fabrication costs, and dealer margins can affect retail prices.
            </p>
          )}

          {!isMetalPair && (
            <p>
              Use the interactive converter above to calculate conversions. It shows validated live reference rates when available and clearly indicates demo mode otherwise.
            </p>
          )}

          <div class="pair-assets-info">
            <div class="asset-info-col">
              <h3 class="asset-info-name">{pair.fromAsset.name}</h3>
              <dl class="asset-meta-list">
                <div class="asset-meta-row">
                  <dt>Code</dt>
                  <dd>{pair.fromCode}</dd>
                </div>
                <div class="asset-meta-row">
                  <dt>Category</dt>
                  <dd>{fromCategoryDisplay}</dd>
                </div>
                {pair.fromAsset.symbol && (
                  <div class="asset-meta-row">
                    <dt>Symbol</dt>
                    <dd>{pair.fromAsset.symbol}</dd>
                  </div>
                )}
                {pair.fromAsset.defaultUnit && (
                  <div class="asset-meta-row">
                    <dt>Unit</dt>
                    <dd>{pair.fromAsset.category === 'metal' ? 'troy oz (default), g' : pair.fromAsset.defaultUnit}</dd>
                  </div>
                )}
              </dl>
            </div>

            <div class="asset-info-col">
              <h3 class="asset-info-name">{pair.toAsset.name}</h3>
              <dl class="asset-meta-list">
                <div class="asset-meta-row">
                  <dt>Code</dt>
                  <dd>{pair.toCode}</dd>
                </div>
                <div class="asset-meta-row">
                  <dt>Category</dt>
                  <dd>{toCategoryDisplay}</dd>
                </div>
                {pair.toAsset.symbol && (
                  <div class="asset-meta-row">
                    <dt>Symbol</dt>
                    <dd>{pair.toAsset.symbol}</dd>
                  </div>
                )}
                {pair.toAsset.defaultUnit && (
                  <div class="asset-meta-row">
                    <dt>Unit</dt>
                    <dd>{pair.toAsset.category === 'metal' ? 'troy oz (default), g' : pair.toAsset.defaultUnit}</dd>
                  </div>
                )}
              </dl>
            </div>
          </div>

          {isUsdToEurPair && (
            <p>
              On this USD-to-EUR page, the entered amount is in US dollars and the estimate is in euros. The EUR-to-USD page reverses the direction, so always read the rate with its source and target currencies in mind.
            </p>
          )}

          {isUsdToAedPair && (
            <p>
              This USD-to-AED estimate uses AllFinConverter's separately configured fixed reference rate of 1 USD = 3.6725 AED, not a Frankfurter rate. A bank, card provider, or exchange service may apply its own rate or fees.
            </p>
          )}

          {isBtcToUsdPair && (
            <p>
              This BTC-to-USD page estimates the dollar value of the entered Bitcoin amount. A changing reference price does not predict the proceeds of a future sale; an exchange's execution price and fees may differ.
            </p>
          )}

          {isUsdToBtcPair && (
            <p>
              This USD-to-BTC page estimates the Bitcoin equivalent of the entered dollar amount. It is not a promise of how much Bitcoin an exchange will sell for that amount; the price may change and provider fees may apply.
            </p>
          )}

          {isGoldToUsdPair && (
            <p>
              On this Gold-to-USD page, the entered gold quantity is valued using a USD-per-troy-ounce reference price. If you select grams, the displayed metal quantity changes unit; the underlying reference is still per troy ounce.
            </p>
          )}

          {isUsdToGoldPair && (
            <p>
              On this USD-to-Gold page, the dollar amount is converted to an indicative gold quantity using the USD-per-troy-ounce reference price. It does not guarantee that a physical coin or bar of that quantity can be bought for the displayed amount.
            </p>
          )}

          {isNzdToZarPair && (
            <p>
              Use this page to estimate the South African rand value of New Zealand dollar amounts, including travel expenses. The displayed reference rate may differ from the amount received or charged by banks, card providers, ATMs, or currency exchange services because their rates, spreads, and fees can vary.
            </p>
          )}

          {isMetalPair && (
            <p>
              Use the interactive converter above to calculate conversions. It shows validated live reference rates when available and clearly indicates demo mode otherwise.
            </p>
          )}

        </div>
      </section>

      <!-- Related Generated Pairs -->
      {relatedPairs.length > 0 && (
        <section class="related-pairs-section" aria-label="Related conversion pairs">
          <div class="related-pairs-header">
            <h2 class="related-pairs-heading">Related Conversion Pairs</h2>
            <p class="related-pairs-subheading">Related conversions</p>
          </div>
          <div class="related-pairs-grid">
            {relatedPairs.map((rel) => (
              <a href={`/${rel.slug}/`} class="related-pair-card">
                <div class="related-pair-codes">
                  <span class="related-code">{rel.fromCode}</span>
                  <span class="related-arrow" aria-hidden="true">&rarr;</span>
                  <span class="related-code">{rel.toCode}</span>
                </div>
                <div class="related-pair-names">
                  {rel.fromAsset.name} to {rel.toAsset.name}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Crawlable Back Link -->
      <div class="back-home-container">
        <a href="/" class="back-home-link">
          <span aria-hidden="true">&larr;</span> All Currencies & Assets
        </a>
      </div>

      <!-- Responsive Ad Placement: Pre-Footer -->
      <AdPlaceholder
        slotId="pair-pre-footer"
        variant="banner"
        class="ad-banner-footer"
      />
    </div>

    <!-- Desktop Side Rail: Right -->
    <AdPlaceholder
      slotId="pair-desktop-right"
      variant="side-rail"
      class="ad-rail-right"
    />
  </div>
</main>
</BaseLayout>
